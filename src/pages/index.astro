---
import BlogCard from "@/components/BlogCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getPosts } from "@/lib/content"

const posts = (await getPosts()).slice(0, 3)
---

<Layout>
  <MetaPage slot="head" />
  <header>
    <p class="eyebrow">Cybersecurity Learner</p>
    <h1>Muhammad Zamzam Fauzan</h1>
    <prose-content>
      <p>
        I'm learning cybersecurity from both sides. I completed the offensive
        phase as a penetration tester in the Dibimbing bootcamp — the report on
        this site is that work, a full assessment of a lab e-commerce app with
        10 findings, 4 of them Critical. I'm now continuing into the blue team
        side as a security analyst.
      </p>
      <p>
        <a
          href="https://drive.google.com/file/d/17kKiCrwzYXaRNwGPMHfqDHrBn2nwPTgE/view"
          target="_blank"
          rel="noopener noreferrer"
          >Download CV</a
        > ·
        <a href="/authors/zamzam">About me</a> ·
        <a href="mailto:mhmmdzamzamfauzan@gmail.com">Email</a>
      </p>
    </prose-content>
  </header>

  <section>
    <h2>Case Studies</h2>
    {posts.length > 0 ? (
        <ul>
          {posts.map((post) => <BlogCard post={post} />)}
        </ul>
      ) : (
        <p>Case studies are being written.</p>
      )}
  </section>
</Layout>

<style>
  header {
    margin-block-end: var(--space-l);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
  }

  h1 {
    font-size: var(--step-2);
    line-height: calc(var(--leading-offset) + 1em);
    font-weight: var(--font-weight-medium);
    margin-block-end: var(--space-xs);
  }

  section {
    h2 {
      margin-block-end: var(--space-s);
      font-size: var(--step-1);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-m);
    }

    > p {
      color: var(--muted-foreground);
    }
  }
</style>
