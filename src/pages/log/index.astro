---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { formatDate } from "@/lib/utils"
import { getCollection } from "astro:content"

const entries = (await getCollection("log", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)
---

<Layout>
  <MetaPage
    slot="head"
    title="Learning Log"
    description="Notes from learning cybersecurity in public — what I'm studying, what works, and what I'm still figuring out."
  />
  <header>
    <h1>Learning Log</h1>
    <p>
      Honest, dated notes from learning in public — work in progress, not
      finished case studies. For completed assessments, see
      <a href="/blog">Case Studies</a>.
    </p>
  </header>

  {entries.length > 0 ? (
      <ul>
        {entries.map((entry) => (
          <li>
            <a href={`/log/${entry.id}`}>{entry.data.title}</a>
            <entry-meta>
              <time datetime={entry.data.date.toISOString()}>
                {formatDate(entry.data.date)}
              </time>
              {entry.data.tags && (
                <entry-tags>
                  {entry.data.tags.map((tag) => <span>#{tag}</span>)}
                </entry-tags>
              )}
            </entry-meta>
            <p>{entry.data.description}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">No entries yet.</p>
    )}
</Layout>

<style>
  header {
    margin-block-end: var(--space-l);

    h1 {
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    > p {
      margin-block-start: var(--space-2xs);
      color: var(--muted-foreground);
    }
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  li {
    display: flex;
    flex-direction: column;

    > a {
      font-size: var(--step-1);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    entry-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3xs);
      margin-block-end: var(--space-3xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);

      entry-tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);

        span {
          color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);
        }
      }

      time ~ entry-tags::before {
        content: "·";
      }
    }

    > p {
      color: var(--muted-foreground);
    }
  }

  .empty {
    color: var(--muted-foreground);
  }
</style>
