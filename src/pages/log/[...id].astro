---
import MetaPage from "@/components/MetaPage.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import Layout from "@/layouts/Layout.astro"
import { formatDate } from "@/lib/utils"
import { getCollection, render, type CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const entries = (await getCollection("log", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  )
  return entries.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: entries[i + 1], next: entries[i - 1] },
  }))
}

type Entry = CollectionEntry<"log">
type Props = { entry: Entry; prev?: Entry; next?: Entry }

const { entry, prev, next } = Astro.props
const { Content } = await render(entry)
---

<Layout crumbs={[{ label: "Learning Log", href: "/log" }, { label: entry.data.title, href: `/log/${entry.id}` }]}>
  <MetaPage slot="head" title={entry.data.title} description={entry.data.description} />
  <ScrollToTop floating />
  <article>
    <header>
      <p class="eyebrow">Learning Log</p>
      <h1>{entry.data.title}</h1>
      <post-meta>
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
        {entry.data.tags && (
          <post-tags>
            {entry.data.tags.map((tag) => <span>#{tag}</span>)}
          </post-tags>
        )}
      </post-meta>
      <p>{entry.data.description}</p>
    </header>
    <prose-content>
      <Content />
    </prose-content>
  </article>

  {(prev || next) && (
    <nav class="log-nav">
      {prev ? <a href={`/log/${prev.id}`} rel="prev">← {prev.data.title}</a> : <span></span>}
      {next ? <a href={`/log/${next.id}`} rel="next">{next.data.title} →</a> : <span></span>}
    </nav>
  )}
</Layout>

<style>
  header {
    margin-block-end: var(--space-m);

    .eyebrow {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      color: var(--accent);
    }

    h1 {
      font-size: var(--step-3);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    post-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3xs);
      margin-block-start: var(--space-3xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);

      post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);

        span {
          color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);
        }
      }

      time ~ post-tags::before {
        content: "·";
      }
    }

    > p {
      margin-block-start: var(--space-2xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }
  }

  .log-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-m);
    border-block-start: 2px solid var(--border);
    font-size: var(--step--1);
  }
</style>
