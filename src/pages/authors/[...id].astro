---
import AuthorCard from "@/components/AuthorCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getCollection, render, type CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const authors = await getCollection("authors")
  return authors.map((author) => ({
    params: { id: author.id },
    props: { author },
  }))
}

type Props = { author: CollectionEntry<"authors"> }

const { author } = Astro.props
const { name, bio } = author.data
const { Content } = await render(author)
---

<Layout crumbs={[{ label: name, href: `/authors/${author.id}` }]}>
  <MetaPage slot="head" title="About" description={bio} />
  <header>
    <ul>
      <AuthorCard author={author} />
    </ul>
  </header>

  <prose-content>
    <Content />
  </prose-content>

</Layout>

<style>
  header,
  prose-content {
    margin-block-end: var(--space-l);
  }
</style>
